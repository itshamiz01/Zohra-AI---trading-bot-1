    <!-- T13: AI MEMORY -->
    <div id="content-memory" class="tab-content">
        <h2 class="section-title">🧠 AI MEMORY</h2>
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
            <div style="font-size:14px;color:var(--text-muted);">Total memories stored: <strong style="color:var(--accent);" id="memory-total-count">0</strong></div>
        </div>
        <div class="memory-search-bar">
            <input type="text" id="memory-search-input" placeholder="Search memories semantically... (e.g. 'winning EURUSD scalp')" onkeydown="if(event.key==='Enter')searchMemory()">
            <button onclick="searchMemory()">🔍 Search</button>
        </div>
        <div class="memory-grid" id="memory-results">
            <div style="color:var(--text-muted)">Loading memories...</div>
        </div>
    </div>

    <!-- T14: LEARNING ENGINE -->
    <div id="content-learning" class="tab-content">
        <h2 class="section-title">📊 LEARNING ENGINE</h2>
        <div class="learning-columns">
            <div>
                <h3 style="color:var(--success);margin-bottom:14px;font-family:'Outfit',sans-serif;">✅ Discovered Winning Patterns</h3>
                <div id="winning-patterns-container">
                    <div style="color:var(--text-muted)">Loading patterns...</div>
                </div>
            </div>
            <div>
                <h3 style="color:var(--danger);margin-bottom:14px;font-family:'Outfit',sans-serif;">❌ Discovered Failure Patterns</h3>
                <div id="failure-patterns-container">
                    <div style="color:var(--text-muted)">Loading patterns...</div>
                </div>
            </div>
        </div>
        <h3 style="color:var(--primary);margin-bottom:14px;font-family:'Outfit',sans-serif;">💡 AI Recommendations</h3>
        <div id="learning-recommendations-container">
            <div style="color:var(--text-muted)">Loading recommendations...</div>
        </div>
    </div>

    <!-- T15: SETTINGS CONTROL PANEL -->
    <div id="content-settings" class="tab-content">
        <h2 class="section-title">⚙️ ZOHRA ENGINE CONFIGURATION</h2>
        <div class="dashboard-grid">
            <div class="card col-6">
                <h2>Risk & Execution Limits</h2>
                <div style="display:flex; flex-direction:column; gap:20px; margin-top:16px;">
                    <div>
                        <label for="settings-risk-pct" style="font-size:13px; color:var(--text-muted); display:block; margin-bottom:8px;">Base Risk Per Trade (scaled by Grade):</label>
                        <div style="display:flex; align-items:center; gap:12px;">
                            <input type="range" id="settings-risk-pct" min="0.1" max="3.0" step="0.1" value="1.0" oninput="document.getElementById('risk-val').innerText = this.value + '%'" style="flex-grow:1; accent-color:var(--primary);">
                            <span id="risk-val" style="font-weight:700; width:45px; text-align:right;">1.0%</span>
                        </div>
                    </div>
                    <div>
                        <label for="settings-max-drawdown" style="font-size:13px; color:var(--text-muted); display:block; margin-bottom:8px;">Max Drawdown Limit (Halt Switch):</label>
                        <div style="display:flex; align-items:center; gap:12px;">
                            <input type="range" id="settings-max-drawdown" min="1.0" max="15.0" step="0.5" value="3.0" oninput="document.getElementById('dd-val').innerText = this.value + '%'" style="flex-grow:1; accent-color:var(--primary);">
                            <span id="dd-val" style="font-weight:700; width:45px; text-align:right;">3.0%</span>
                        </div>
                    </div>
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <span style="font-size:14px;">Allow Speculative C-Grade Setups:</span>
                        <input type="checkbox" id="settings-allow-c" style="width:20px; height:20px; accent-color:var(--accent);">
                    </div>
                    <div>
                        <label for="settings-max-positions" style="font-size:13px; color:var(--text-muted); display:block; margin-bottom:8px;">Max Open Positions Limit:</label>
                        <input type="number" id="settings-max-positions" min="1" max="10" value="5" class="filter-select" style="width:100px;">
                    </div>
                </div>
            </div>
            <div class="card col-6">
                <h2>Dynamic System Variables</h2>
                <div style="display:flex; flex-direction:column; gap:20px; margin-top:16px;">
                    <div>
                        <label for="settings-max-daily-loss" style="font-size:13px; color:var(--text-muted); display:block; margin-bottom:8px;">Max Daily Loss Limit:</label>
                        <div style="display:flex; align-items:center; gap:12px;">
                            <input type="range" id="settings-max-daily-loss" min="0.5" max="5.0" step="0.1" value="2.0" oninput="document.getElementById('loss-val').innerText = this.value + '%'" style="flex-grow:1; accent-color:var(--primary);">
                            <span id="loss-val" style="font-weight:700; width:45px; text-align:right;">2.0%</span>
                        </div>
                    </div>
                    <div>
                        <label for="settings-api-token" style="font-size:13px; color:var(--text-muted); display:block; margin-bottom:8px;">API Access Token (Required for Save):</label>
                        <input type="password" id="settings-api-token" placeholder="Enter security token..." class="filter-input" style="width:100%;">
                    </div>
                    <div style="margin-top:20px; display:flex; gap:15px;">
                        <button class="btn" onclick="saveSettings()" style="flex-grow:1; background:var(--accent); color:#05060b; border-color:var(--accent);">💾 Save Settings</button>
                        <button class="btn" onclick="loadSettings()" style="flex-grow:1;">🔄 Reload</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Trade Explainability Modal -->
    <div class="modal" id="explainer-modal" onclick="closeExplainerModal(event)">
        <div class="modal-content" onclick="event.stopPropagation()">
            <button class="modal-close" onclick="document.getElementById('explainer-modal').style.display='none'">×</button>
            <div class="explainer-title" id="exp-title">Trade Explainer #0000</div>
            
            <div class="explainer-block taken" id="exp-block-taken">
                <div class="explainer-label">Why This Trade Was Taken</div>
                <div class="explainer-val" id="exp-reason-taken">Evaluating confluence triggers...</div>
            </div>

            <div class="explainer-block lost" id="exp-block-lost" style="display: none;">
                <div class="explainer-label">Why This Trade Lost (Post-Mortem Analysis)</div>
                <div class="explainer-val" id="exp-reason-lost">Market state dynamics analysis...</div>
            </div>

            <div class="explainer-label">Confluence Breakdown Matrix</div>
            <div class="check-grid" id="exp-grid">
                <div class="check-item"><span>Market Structure:</span> <strong id="exp-val-structure">N/A</strong></div>
                <div class="check-item"><span>Liquidity Sweep:</span> <strong id="exp-val-liquidity">N/A</strong></div>
                <div class="check-item"><span>SMC Analysis:</span> <strong id="exp-val-smc">N/A</strong></div>
                <div class="check-item"><span>Trend Factor:</span> <strong id="exp-val-trend">N/A</strong></div>
                <div class="check-item"><span>Momentum Scan:</span> <strong id="exp-val-momentum">N/A</strong></div>
                <div class="check-item"><span>Volatility Ratio:</span> <strong id="exp-val-volatility">N/A</strong></div>
                <div class="check-item"><span>Pullback Zone:</span> <strong id="exp-val-pullback">N/A</strong></div>
                <div class="check-item"><span>R:R Ratio:</span> <strong id="exp-val-rr">N/A</strong></div>
            </div>
        </div>
    </div>

    <script>
        let closedTrades = [];
        let rejections = [];
        let chart = null;
        let mcChart = null;

        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            
            document.getElementById(`content-${tabId}`).classList.add('active');
            document.getElementById(`tab-${tabId}`).classList.add('active');

            if (tabId === 'overview' && chart) {
                setTimeout(() => chart.windowResizeHandler(), 100);
            }
        }

        function closeExplainerModal(event) {
            document.getElementById('explainer-modal').style.display = 'none';
        }

        async function initDashboard() {
            await fetchDashboard();
            await fetchAdvancedData();
            loadRecentMemories();
            loadLearningData();
            loadSettings();
            initTradingViewWidget();
            connectWebSocket();
            setInterval(fetchDashboard, 30000);
            setInterval(fetchAdvancedData, 10000);
            setInterval(loadRecentMemories, 30000);
            setInterval(loadLearningData, 60000);
        }

        async function fetchDashboard() {
            try {
                // 1. Fetch Health
                const hRes = await fetch('/api/v1/health');
                const health = await hRes.json();
                document.getElementById('kpi-trades').innerText = health.daily_trades;
                document.getElementById('kpi-today-pnl').querySelector('.kpi-val').innerText = `$${health.daily_pnl.toFixed(2)}`;
                document.getElementById('kpi-today-pnl').className = health.daily_pnl >= 0 ? 'kpi-box green' : 'kpi-box red';
                document.getElementById('engine-status-text').innerText = health.halted ? 'HALTED' : 'ACTIVE';
                document.getElementById('engine-status-text').className = health.halted ? 'text-red' : 'text-green';

                const targetRem = Math.max(0.0, 25.0 - health.daily_pnl);
                document.getElementById('kpi-target-remaining').querySelector('.kpi-val').innerText = `$${targetRem.toFixed(2)}`;
                document.getElementById('kpi-target-remaining').className = targetRem === 0 ? 'kpi-box green' : 'kpi-box';

                // 2. Fetch Account info
                const aRes = await fetch('/api/v1/account');
                const account = await aRes.json();
                document.getElementById('kpi-equity').innerText = `$${(account.equity || 0).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;

                // 3. Fetch Portfolio limits
                const eRes = await fetch('/api/v1/exposure');
                const exp = await eRes.json();
                document.getElementById('forex-exposure-txt').innerText = `${exp.sectors.Forex} / ${exp.max_sector_caps.Forex}`;
                document.getElementById('metals-exposure-txt').innerText = `${exp.sectors.Metals} / ${exp.max_sector_caps.Metals}`;
                document.getElementById('usd-exposure-txt').innerText = `${exp.currency_stack.USD || 0} / ${exp.max_currency_cap}`;
                document.getElementById('usd-exposure-txt').className = (exp.currency_stack.USD || 0) >= exp.max_currency_cap ? 'text-red' : 'text-green';

                // 4. Fetch Opportunities
                const oRes = await fetch('/api/v1/opportunities');
                const opps = await oRes.json();
                const lBody = document.getElementById('leaderboard-tbody');
                lBody.innerHTML = '';
                if (opps.opportunities && opps.opportunities.length > 0) {
                    opps.opportunities.forEach(opp => {
                        const tr = document.createElement('tr');
                        tr.innerHTML = `
                            <td><strong>${opp.symbol}</strong></td>
                            <td><span class="badge badge-info">${opp.strategy}</span></td>
                            <td><span class="badge ${opp.direction === 'LONG' ? 'badge-buy' : 'badge-sell'}">${opp.direction}</span></td>
                            <td><strong>${opp.confidence_score}</strong></td>
                            <td><span class="text-green">Active Monitoring</span></td>
                        `;
                        lBody.appendChild(tr);
                    });
                } else {
                    lBody.innerHTML = `<tr><td colspan="5" style="text-align: center; color: var(--text-muted);">No setups on leaderboard. Scanning...</td></tr>`;
                }

                // 5. Fetch Open positions
                const openRes = await fetch('/api/v1/trades/open');
                const openData = await openRes.json();
                const openBody = document.getElementById('open-positions-tbody');
                openBody.innerHTML = '';
                if (openData.trades && openData.trades.length > 0) {
                    openData.trades.forEach(t => {
                        const tr = document.createElement('tr');
                        const profitClass = t.pnl_usd >= 0 ? 'text-green' : 'text-red';
                        tr.innerHTML = `
                            <td>#${t.mt5_ticket}</td>
                            <td><strong>${t.symbol}</strong></td>
                            <td><span class="badge ${t.direction === 'LONG' ? 'badge-buy' : 'badge-sell'}">${t.direction}</span></td>
                            <td>${t.position_size_lots.toFixed(2)}</td>
                            <td>${t.entry_price.toFixed(5)}</td>
                            <td>${t.stop_loss.toFixed(5)}</td>
                            <td>${t.take_profit.toFixed(5)}</td>
                            <td class="${profitClass}"><strong>$${(t.pnl_usd || 0.0).toFixed(2)}</strong></td>
                        `;
                        openBody.appendChild(tr);
                    });
                } else {
                    openBody.innerHTML = `<tr><td colspan="8" style="text-align: center; color: var(--text-muted);">No open positions.</td></tr>`;
                }

                // 6. Fetch Closed Trades (Journal & Performance)
                const tRes = await fetch('/api/v1/trades?limit=500');
                const tData = await tRes.json();
                closedTrades = tData.trades || [];

                // 7. Fetch Rejections
                const rRes = await fetch('/api/v1/rejections?limit=500');
                const rData = await rRes.json();
                rejections = rData.rejections || [];

                // Perform all statistics computations and render
                calculateGlobalMetrics();
                renderSymbolsMatrix();
                renderRejections();
                renderJournal();
                renderAICoach();
                renderEquityChart();

            } catch (err) {
                console.error("Fetch dashboard error: ", err);
            }
        }

        async function fetchAdvancedData() {
            try {
                // 1. Fetch detailed exposures
                const expRes = await fetch('/api/v1/advanced/exposure');
                const expData = await expRes.json();
                const container = document.getElementById('exposures-container');
                container.innerHTML = '';
                Object.keys(expData.exposures).forEach(k => {
                    const val = expData.exposures[k];
                    const percent = Math.min(100, (Math.abs(val) / (expData.total_exposure_usd || 1000.0)) * 100);
                    const color = val >= 0 ? '#00ffcc' : '#ff007f';
                    const div = document.createElement('div');
                    div.innerHTML = `
                        <div style="display: flex; justify-content: space-between; font-size: 14px;">
                            <span><strong>${k}</strong> Basket</span>
                            <span style="color: ${color}; font-weight: 700;">$${val.toFixed(2)}</span>
                        </div>
                        <div class="exp-bar-container">
                            <div class="exp-bar-fill" style="width: ${percent}%; background-color: ${color};"></div>
                        </div>
                    `;
                    container.appendChild(div);
                });

                // 2. Fetch correlations
                const corrRes = await fetch('/api/v1/advanced/correlation');
                const corrData = await corrRes.json();
                const table = document.getElementById('correlation-table');
                table.innerHTML = '';
                const keys = Object.keys(corrData.matrix);
                
                // Header
                let thRow = '<tr><th>Symbol</th>';
                keys.forEach(k => thRow += `<th>${k}</th>`);
                thRow += '</tr>';
                table.innerHTML += thRow;
                
                // Rows
                keys.forEach(k1 => {
                    let tdRow = `<tr><td><strong>${k1}</strong></td>`;
                    keys.forEach(k2 => {
                        const val = corrData.matrix[k1][k2];
                        let colorClass = '';
                        if (Math.abs(val) > 0.8) colorClass = 'text-red';
                        else if (Math.abs(val) < 0.3) colorClass = 'text-muted';
                        else colorClass = 'text-green';
                        tdRow += `<td class="corr-cell ${colorClass}">${val.toFixed(2)}</td>`;
                    });
                    tdRow += '</tr>';
                    table.innerHTML += tdRow;
                });
                
                // Correlation alerts
                const alertDiv = document.getElementById('correlation-alerts');
                alertDiv.innerHTML = '';
                corrData.alerts.forEach(al => {
                    alertDiv.innerHTML += `<div class="text-red" style="margin-bottom: 6px;">⚠️ ${al}</div>`;
                });

                // 3. Fetch concentration warning
                const concRes = await fetch('/api/v1/advanced/risk-concentration');
                const concData = await concRes.json();
                const concList = document.getElementById('concentration-alerts-list');
                concList.innerHTML = '';
                if (concData.alerts.length > 0) {
                    concData.alerts.forEach(al => {
                        concList.innerHTML += `<div class="insight-box" style="border-left: 4px solid var(--danger);">
                            <div class="explainer-label text-red">CONCENTRATION ALERT</div>
                            <div style="font-size: 13px;">${al}</div>
                        </div>`;
                    });
                    concData.recommendations.forEach(rec => {
                        concList.innerHTML += `<div class="insight-box" style="border-left: 4px solid var(--accent);">
                            <div class="explainer-label text-green">RECOMMENDATION</div>
                            <div style="font-size: 13px;">${rec}</div>
                        </div>`;
                    });
                } else {
                    concList.innerHTML = `<div style="text-align: center; color: var(--text-muted); padding: 20px;">Risk distribution is within target boundaries.</div>`;
                }

                // 4. Fetch margin health
                const marginRes = await fetch('/api/v1/advanced/margin-health');
                const marginData = await marginRes.json();
                if (!marginData.error) {
                    document.getElementById('margin-level-val').innerText = `${(marginData.margin_level || 0.0).toFixed(1)}%`;
                    document.getElementById('liquidation-risk-val').innerText = marginData.liquidation_risk;
                    document.getElementById('liquidation-risk-val').className = marginData.liquidation_risk === "LOW" ? 'text-green' : 'text-red';
                    document.getElementById('margin-used-val').innerText = `$${(marginData.margin_used || 0.0).toFixed(2)}`;
                    document.getElementById('margin-free-val').innerText = `$${(marginData.margin_free || 0.0).toFixed(2)}`;
                }

                // 5. Fetch strategies performance
                const stratRes = await fetch('/api/v1/advanced/performance/strategies');
                const stratData = await stratRes.json();
                const stratBody = document.getElementById('strategies-performance-tbody');
                stratBody.innerHTML = '';
                Object.keys(stratData.strategies).forEach(k => {
                    const item = stratData.strategies[k];
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td><strong>${k}</strong></td>
                        <td>${item.trades}</td>
                        <td class="text-green">${item.wins}</td>
                        <td class="text-red">${item.losses}</td>
                        <td><strong>${item.win_rate}%</strong></td>
                        <td class="${item.pnl >= 0 ? 'text-green' : 'text-red'}"><strong>$${item.pnl.toFixed(2)}</strong></td>
                        <td>${item.avg_hold_time} min</td>
                        <td>${item.avg_rr} R</td>
                    `;
                    stratBody.appendChild(tr);
                });

                // Grade performance
                const gradeBody = document.getElementById('grade-performance-tbody');
                if (gradeBody && stratData.grades) {
                    gradeBody.innerHTML = '';
                    Object.keys(stratData.grades).forEach(k => {
                        const item = stratData.grades[k];
                        const tr = document.createElement('tr');
                        tr.innerHTML = `
                            <td><strong>${k}</strong></td>
                            <td>${item.trades}</td>
                            <td class="text-green">${item.wins}</td>
                            <td class="text-red">${item.losses}</td>
                            <td><strong>${item.win_rate}%</strong></td>
                            <td>${item.profit_factor}</td>
                            <td>${item.avg_drawdown}%</td>
                            <td>${item.avg_r_multiple}R</td>
                            <td>$${item.expected_value.toFixed(2)}</td>
                            <td class="${item.pnl >= 0 ? 'text-green' : 'text-red'}"><strong>$${item.pnl.toFixed(2)}</strong></td>
                        `;
                        gradeBody.appendChild(tr);
                    });
                }

                // Conditions
                const condTable = document.getElementById('conditions-performance-table');
                condTable.innerHTML = '<tr><th>Regime</th><th>Trades</th><th>Win Rate</th><th>PnL</th></tr>';
                Object.keys(stratData.regimes).forEach(k => {
                    const item = stratData.regimes[k];
                    condTable.innerHTML += `
                        <tr>
                            <td><strong>${k}</strong></td>
                            <td>${item.trades}</td>
                            <td>${item.win_rate}%</td>
                            <td class="${item.pnl >= 0 ? 'text-green' : 'text-red'}">$${item.pnl.toFixed(2)}</td>
                        </tr>
                    `;
                });

                // Sessions
                const sessTable = document.getElementById('sessions-performance-table');
                sessTable.innerHTML = '<tr><th>Session</th><th>Trades</th><th>Win Rate</th><th>PnL</th></tr>';
                Object.keys(stratData.sessions).forEach(k => {
                    const item = stratData.sessions[k];
                    sessTable.innerHTML += `
                        <tr>
                            <td><strong>${k}</strong></td>
                            <td>${item.trades}</td>
                            <td>${item.win_rate}%</td>
                            <td class="${item.pnl >= 0 ? 'text-green' : 'text-red'}">$${item.pnl.toFixed(2)}</td>
                        </tr>
                    `;
                });

                // Timeframes
                const tfTable = document.getElementById('timeframe-performance-table');
                tfTable.innerHTML = '<tr><th>Timeframe</th><th>Trades</th><th>Win Rate</th><th>PnL</th></tr>';
                Object.keys(stratData.timeframes).forEach(k => {
                    const item = stratData.timeframes[k];
                    tfTable.innerHTML += `
                        <tr>
                            <td><strong>${k}</strong></td>
                            <td>${item.trades}</td>
                            <td>${item.win_rate}%</td>
                            <td class="${item.pnl >= 0 ? 'text-green' : 'text-red'}">$${item.pnl.toFixed(2)}</td>
                        </tr>
                    `;
                });

                // 6. Fetch missed opportunities
                const missedRes = await fetch('/api/v1/advanced/missed-opportunities');
                const missedData = await missedRes.json();
                
                // 7. Fetch false signals
                const falseRes = await fetch('/api/v1/advanced/false-signals');
                const falseData = await falseRes.json();
                
                // 8. Fetch broker metrics
                const brokerRes = await fetch('/api/v1/advanced/broker-performance');
                const brokerData = await brokerRes.json();
                document.getElementById('exec-delay-val').innerText = `${brokerData.execution_delay_ms} ms`;
                document.getElementById('broker-lat-val').innerText = `${brokerData.broker_latency_ms} ms`;
                document.getElementById('avg-spread-val').innerText = `${brokerData.average_spread_pips} Pips`;
                document.getElementById('slippage-val').innerText = `${brokerData.average_slippage_points} Points`;

                // 9. Fetch system health
                const sHealthRes = await fetch('/api/v1/advanced/system-health');
                const sHealthData = await sHealthRes.json();
                const mList = document.getElementById('modules-health-list');
                mList.innerHTML = '';
                Object.keys(sHealthData.modules).forEach(k => {
                    const item = sHealthData.modules[k];
                    const activeClass = item.status === "RUNNING" ? 'text-green' : 'text-red';
                    mList.innerHTML += `
                        <div class="insight-box" style="display: flex; justify-content: space-between; align-items: center;">
                            <div><strong>${k}</strong></div>
                            <div style="font-size: 13px;">Uptime state: <strong class="${activeClass}">${item.status}</strong></div>
                            <div style="font-size: 13px; color: var(--text-muted);">${item.latency_ms} ms delay</div>
                        </div>
                    `;
                });

                // 10. Fetch debriefs
                const debriefRes = await fetch('/api/v1/advanced/debrief');
                const debriefData = await debriefRes.json();
                document.getElementById('debrief-morning').innerText = debriefData.morning_brief;
                document.getElementById('debrief-midday').innerText = debriefData.midday_brief;
                document.getElementById('debrief-eod').innerText = debriefData.end_of_day_review;

                // 11. Fetch Monte Carlo
                const mcRes = await fetch('/api/v1/advanced/monte-carlo');
                const mcData = await mcRes.json();
                document.getElementById('ruin-probability-val').innerText = `${mcData.ruin_probability_pct}%`;
                document.getElementById('ruin-probability-val').className = mcData.ruin_probability_pct > 10.0 ? 'text-red' : 'text-green';
                renderMonteCarloChart(mcData.sample_paths);
                
                // Run simulator once initialized
                runRiskSimulation();

            } catch (e) {
                console.error("Advanced fetch metrics error: ", e);
            }
        }

        async function submitNLPQuery() {
            const val = document.getElementById('nlp-query-input').value;
            if (!val) return;
            
            const resBox = document.getElementById('nlp-response-box');
            resBox.style.display = 'block';
            resBox.innerText = "Querying cognitive databases...";
            
            try {
                const res = await fetch('/api/v1/advanced/nl-query', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({query: val})
                });
                const data = await res.json();
                resBox.innerText = data.response;
            } catch(e) {
                resBox.innerText = "Error executing search: " + e;
            }
        }

        async function runRiskSimulation() {
            const mult = document.getElementById('sim-lot-mult').value;
            const stop = document.getElementById('sim-stop-equity').value;
            const disable = document.getElementById('sim-disable-jpy').value === "true";
            
            try {
                const res = await fetch('/api/v1/advanced/simulate-risk', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({lot_mult: mult, stop_equity: stop, disable_usd_jpy: disable})
                });
                const data = await res.json();
                document.getElementById('sim-orig-pnl').innerText = `$${data.original_net_profit.toFixed(2)}`;
                document.getElementById('sim-new-pnl').innerText = `$${data.simulated_net_profit.toFixed(2)}`;
                document.getElementById('sim-new-pnl').className = data.simulated_net_profit >= 0 ? 'text-green' : 'text-red';
                document.getElementById('sim-new-dd').innerText = `${data.simulated_drawdown_pct}%`;
                document.getElementById('sim-margin-level-state').innerText = data.margin_level_impact;
                document.getElementById('sim-margin-level-state').className = data.margin_level_impact === "HEALTHY" ? 'text-green' : 'text-red';
            } catch(e) {
                console.error("Simulation request failed", e);
            }
        }

        function calculateGlobalMetrics() {
            if (closedTrades.length === 0) return;

            let grossProfit = 0;
            let grossLoss = 0;
            let totalQuality = 0;
            let totalDur = 0;
            let countWin = 0;
            let countLoss = 0;

            closedTrades.forEach(t => {
                const pnl = parseFloat(t.pnl_usd || 0);
                if (pnl > 0) {
                    grossProfit += pnl;
                    countWin++;
                } else if (pnl < 0) {
                    grossLoss += Math.abs(pnl);
                    countLoss++;
                }
                totalQuality += parseInt(t.confidence_score || 0);
                totalDur += parseFloat(t.duration_minutes || 0);
            });

            const totalClosed = closedTrades.length;
            const netProfit = grossProfit - grossLoss;
            const pf = grossLoss > 0 ? (grossProfit / grossLoss) : grossProfit;
            const avgQuality = totalClosed > 0 ? (totalQuality / totalClosed) : 0.0;
            const avgWin = countWin > 0 ? (grossProfit / countWin) : 0.0;
            const avgLoss = countLoss > 0 ? (grossLoss / countLoss) : 0.0;
            const avgHolding = totalClosed > 0 ? (totalDur / totalClosed) : 0.0;
            const winRate = totalClosed > 0 ? (countWin / totalClosed * 100) : 0.0;

            const expectancy = (winRate/100 * avgWin) - ((100-winRate)/100 * avgLoss);

            document.getElementById('kpi-pf').innerText = pf.toFixed(2);
            document.getElementById('kpi-pf').className = pf >= 1.5 ? 'kpi-val text-green' : 'kpi-val text-red';
            document.getElementById('kpi-avg-quality').innerText = avgQuality.toFixed(1);

            document.getElementById('stat-gross-profit').innerText = `$${grossProfit.toFixed(2)}`;
            document.getElementById('stat-gross-loss').innerText = `-$${grossLoss.toFixed(2)}`;
            document.getElementById('stat-avg-win').innerText = `$${avgWin.toFixed(2)}`;
            document.getElementById('stat-avg-loss').innerText = `-$${avgLoss.toFixed(2)}`;
            document.getElementById('stat-holding-time').innerText = `${avgHolding.toFixed(1)} min`;
            document.getElementById('stat-expectancy').innerText = `$${expectancy.toFixed(2)}`;
            document.getElementById('stat-expectancy').className = expectancy >= 0 ? 'text-green' : 'text-red';

            let returns = closedTrades.map(t => parseFloat(t.pnl_usd || 0));
            if (returns.length > 1) {
                let mean = returns.reduce((a,b)=>a+b, 0) / returns.length;
                let variance = returns.reduce((a,b)=>a + Math.pow(b - mean, 2), 0) / (returns.length - 1);
                let stddev = Math.sqrt(variance);
                let sharpe = stddev > 0 ? (mean / stddev) * Math.sqrt(252) : 0.0;
                document.getElementById('stat-sharpe').innerText = sharpe.toFixed(2);
            }
        }

        function renderSymbolsMatrix() {
            const tbody = document.getElementById('symbols-matrix-tbody');
            if (closedTrades.length === 0) {
                tbody.innerHTML = `<tr><td colspan="10" style="text-align: center; color: var(--text-muted);">No symbols trading history found.</td></tr>`;
                return;
            }

            const symData = {};
            closedTrades.forEach(t => {
                const sym = t.symbol;
                if (!symData[sym]) {
                    symData[sym] = { trades: 0, wins: 0, losses: 0, profit: 0.0, gp: 0.0, gl: 0.0, sumQuality: 0 };
                }
                const p = symData[sym];
                p.trades++;
                const pnl = parseFloat(t.pnl_usd || 0);
                p.profit += pnl;
                if (pnl > 0) {
                    p.wins++;
                    p.gp += pnl;
                } else if (pnl < 0) {
                    p.losses++;
                    p.gl += Math.abs(pnl);
                }
                p.sumQuality += parseInt(t.confidence_score || 0);
            });

            tbody.innerHTML = '';
            Object.keys(symData).forEach(sym => {
                const p = symData[sym];
                const winRate = p.trades > 0 ? (p.wins / p.trades * 100) : 0;
                const avgProfit = p.wins > 0 ? (p.gp / p.wins) : 0;
                const avgLoss = p.losses > 0 ? (p.gl / p.losses) : 0;
                const pf = p.gl > 0 ? (p.gp / p.gl) : p.gp;
                const avgQual = p.trades > 0 ? (p.sumQuality / p.trades) : 0;

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td><strong>${sym}</strong></td>
                    <td>${p.trades}</td>
                    <td class="text-green">${p.wins}</td>
                    <td class="text-red">${p.losses}</td>
                    <td><strong>${winRate.toFixed(0)}%</strong></td>
                    <td class="${p.profit >= 0 ? 'text-green' : 'text-red'}"><strong>$${p.profit.toFixed(2)}</strong></td>
                    <td class="text-green">$${avgProfit.toFixed(2)}</td>
                    <td class="text-red">-$${avgLoss.toFixed(2)}</td>
                    <td>${pf.toFixed(2)}</td>
                    <td><strong class="text-green">${avgQual.toFixed(0)}</strong></td>
                `;
                tbody.appendChild(tr);

                populateFilterOptions('rejections-symbol-filter', sym);
                populateFilterOptions('journal-symbol-filter', sym);
            });
        }

        function populateFilterOptions(selectId, value) {
            const select = document.getElementById(selectId);
            if (![...select.options].some(o => o.value === value)) {
                const opt = document.createElement('option');
                opt.value = value;
                opt.text = value;
                select.add(opt);
            }
        }

        function renderRejections() {
            filterRejections();
        }

        function filterRejections() {
            const tbody = document.getElementById('rejections-tbody');
            const searchVal = document.getElementById('rejections-search').value.toLowerCase();
            const symbolVal = document.getElementById('rejections-symbol-filter').value;

            const filtered = rejections.filter(r => {
                const matchesSearch = r.symbol.toLowerCase().includes(searchVal) || 
                                      r.reason_for_rejection.toLowerCase().includes(searchVal);
                const matchesSymbol = symbolVal === "" || r.symbol === symbolVal;
                return matchesSearch && matchesSymbol;
            });

            tbody.innerHTML = '';
            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" style="text-align: center; color: var(--text-muted);">No rejections match the filters.</td></tr>`;
                return;
            }

            filtered.forEach(r => {
                const tr = document.createElement('tr');
                const cond = typeof r.failed_conditions === "string" ? JSON.parse(r.failed_conditions) : (r.failed_conditions || []);
                tr.innerHTML = `
                    <td><span class="log-ts">${r.timestamp.replace('T', ' ').substring(0, 19)}</span></td>
                    <td><strong>${r.symbol}</strong></td>
                    <td><span class="badge ${r.direction === 'LONG' ? 'badge-buy' : 'badge-sell'}">${r.direction}</span></td>
                    <td><strong>${r.confidence_score}</strong></td>
                    <td class="text-red">${r.reason_for_rejection}</td>
                    <td style="font-size: 12px; color: var(--text-muted);">${cond.join(' | ')}</td>
                `;
                tbody.appendChild(tr);
            });
        }

        function renderJournal() {
            filterJournal();
        }

        function filterJournal() {
            const tbody = document.getElementById('journal-tbody');
            const searchVal = document.getElementById('journal-search').value.toLowerCase();
            const symbolVal = document.getElementById('journal-symbol-filter').value;
            const dirVal = document.getElementById('journal-dir-filter').value;
            const resultVal = document.getElementById('journal-result-filter').value;

            const filtered = closedTrades.filter(t => {
                const matchesSearch = t.trade_id.toLowerCase().includes(searchVal) || 
                                      t.symbol.toLowerCase().includes(searchVal) || 
                                      (t.reason_for_entry && t.reason_for_entry.toLowerCase().includes(searchVal));
                const matchesSymbol = symbolVal === "" || t.symbol === symbolVal;
                const matchesDir = dirVal === "" || t.direction === dirVal;
                
                let matchesResult = true;
                const pnl = parseFloat(t.pnl_usd || 0);
                if (resultVal === "WIN") matchesResult = pnl > 0.01;
                else if (resultVal === "LOSS") matchesResult = pnl < -0.01;
                else if (resultVal === "BE") matchesResult = Math.abs(pnl) <= 0.01;

                return matchesSearch && matchesSymbol && matchesDir && matchesResult;
            });

            tbody.innerHTML = '';
            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="12" style="text-align: center; color: var(--text-muted);">No closed trades match the filters.</td></tr>`;
                return;
            }

            filtered.forEach(t => {
                const pnl = parseFloat(t.pnl_usd || 0);
                const score = parseInt(t.confidence_score || 0);
                let grade = "Standard B";
                let gradeClass = "badge-info";
                if (score >= 95) { grade = "Inst. A+"; gradeClass = "badge-buy"; }
                else if (score >= 80) { grade = "Strong A"; gradeClass = "badge-buy"; }
                
                const tr = document.createElement('tr');
                tr.style.cursor = 'pointer';
                tr.onclick = () => {
                    showTradeExplainer(t);
                    loadPlaybackSimulation(t);
                };
                tr.innerHTML = `
                    <td><strong>#${t.mt5_ticket}</strong></td>
                    <td><span class="log-ts">${t.timestamp_open.replace('T', ' ').substring(0, 19)}</span></td>
                    <td><strong>${t.symbol}</strong></td>
                    <td><span class="badge ${t.direction === 'LONG' ? 'badge-buy' : 'badge-sell'}">${t.direction}</span></td>
                    <td>${t.position_size_lots.toFixed(2)}</td>
                    <td>${t.entry_price.toFixed(5)}</td>
                    <td>${t.exit_price ? t.exit_price.toFixed(5) : 'N/A'}</td>
                    <td class="${pnl >= 0 ? 'text-green' : 'text-red'}"><strong>$${pnl.toFixed(2)}</strong></td>
                    <td><strong>${score}</strong></td>
                    <td><span class="badge ${gradeClass}">${grade}</span></td>
                    <td>${t.strategy_used || 'scalp_m5'}</td>
                    <td style="font-size: 12px; color: var(--text-muted); text-overflow: ellipsis; max-width: 250px; overflow: hidden; white-space: nowrap;">${t.reason_for_entry}</td>
                `;
                tbody.appendChild(tr);
            });
        }

        function showTradeExplainer(trade) {
            document.getElementById('exp-title').innerText = `Execution Explainer Matrix | Trade #${trade.mt5_ticket} (${trade.symbol})`;
            document.getElementById('exp-reason-taken').innerText = trade.reason_for_entry || "Executed on confluences validation.";

            const pnl = parseFloat(trade.pnl_usd || 0);
            if (pnl < 0) {
                document.getElementById('exp-block-lost').style.display = 'block';
                document.getElementById('exp-reason-lost').innerText = `Trade closed at a loss of $${Math.abs(pnl).toFixed(2)}. Exit Trigger: ${trade.reason_for_exit || 'Stop Loss hit'}. Post-Mortem: Price broke structural support or experienced volatility expansion during the news windows.`;
            } else {
                document.getElementById('exp-block-lost').style.display = 'none';
            }

            document.getElementById('exp-val-structure').innerText = (trade.score_structure || "70") + " pts";
            document.getElementById('exp-val-liquidity').innerText = (trade.score_liquidity || "80") + " pts";
            document.getElementById('exp-val-smc').innerText = (trade.score_smc || "60") + " pts";
            document.getElementById('exp-val-trend').innerText = (trade.score_trend || "70") + " pts";
            document.getElementById('exp-val-momentum').innerText = (trade.score_momentum || "85") + " pts";
            document.getElementById('exp-val-volatility').innerText = (trade.score_volatility || "70") + " pts";
            document.getElementById('exp-val-pullback').innerText = (trade.score_pullback || "70") + " pts";
            document.getElementById('exp-val-rr').innerText = (trade.risk_reward_ratio ? trade.risk_reward_ratio.toFixed(2) : "1.5") + " R";

            document.getElementById('explainer-modal').style.display = 'flex';
        }

        function loadPlaybackSimulation(trade) {
            // Draw simulated candle charts step-by-step
            const container = document.getElementById('playback-chart-container');
            container.innerHTML = `<div id="playback-inner-chart" style="width: 100%; height: 100%;"></div>`;
            
            const options = {
                series: [{
                    data: [
                        { x: new Date(1538778600000), y: [6629.81, 6650.5, 6622.98, 6632.01] },
                        { x: new Date(1538780400000), y: [6632.01, 6643.59, 6620, 6630.11] },
                        { x: new Date(1538782200000), y: [6630.11, 6636.39, 6610, 6618.31] },
                        { x: new Date(1538784000000), y: [6618.31, 6625, 6590, 6608.23] },
                        { x: new Date(1538785800000), y: [6608.23, 6612, 6601.31, 6605.0] }
                    ]
                }],
                chart: {
                    type: 'candlestick',
                    height: 330,
                    background: 'transparent',
                    foreColor: '#838fa7',
                    toolbar: { show: false }
                },
                xaxis: {
                    type: 'datetime'
                },
                yaxis: {
                    tooltip: {
                        enabled: true
                    }
                }
            };
            const pChart = new ApexCharts(document.querySelector("#playback-inner-chart"), options);
            pChart.render();
            
            // Build decision timeline
            const tList = document.getElementById('timeline-log-list');
            tList.innerHTML = `
                <div class="timeline-step">
                    <strong>[${trade.timestamp_open.substring(11,19)}] Signal Scanned</strong>
                    <p style="font-size: 12px; color: var(--text-muted); margin: 4px 0;">Strategy ${trade.strategy_used} triggered alignment matrix.</p>
                </div>
                <div class="timeline-step">
                    <strong>Score Compiled: ${trade.confidence_score} Points</strong>
                    <p style="font-size: 12px; color: var(--text-muted); margin: 4px 0;">Structure: ${trade.score_structure} | SMC: ${trade.score_smc} | Volatility: ${trade.score_volatility}</p>
                </div>
                <div class="timeline-step">
                    <strong>Risk Approval Passed</strong>
                    <p style="font-size: 12px; color: var(--text-muted); margin: 4px 0;">Margin validation cleared at leverage 1:500.</p>
                </div>
                <div class="timeline-step closed">
                    <strong>Closed at exit price: ${trade.exit_price || 'N/A'}</strong>
                    <p style="font-size: 12px; color: var(--text-muted); margin: 4px 0;">Outcome: ${trade.pnl_usd >= 0 ? 'WIN' : 'LOSS'} | Exit code: ${trade.exit_reason_code || 'SL_HIT'}</p>
                </div>
            `;
            
            switchTab('playback');
        }

        function exportJournalCSV() {
            if (closedTrades.length === 0) {
                alert("No trades to export.");
                return;
            }

            let csvContent = "data:text/csv;charset=utf-8,";
            csvContent += "Ticket,Timestamp,Symbol,Direction,Lots,Entry,Exit,PnL,Score,Strategy,Reason\n";

            closedTrades.forEach(t => {
                const row = [
                    t.mt5_ticket,
                    t.timestamp_open,
                    t.symbol,
                    t.direction,
                    t.position_size_lots,
                    t.entry_price,
                    t.exit_price || "",
                    t.pnl_usd,
                    t.confidence_score,
                    t.strategy_used,
                    `"${t.reason_for_entry ? t.reason_for_entry.replace(/"/g, '""') : ''}"`
                ].join(",");
                csvContent += row + "\n";
            });

            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", `zohra_trade_journal_${new Date().toISOString().substring(0,10)}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        function renderAICoach() {
            const container = document.getElementById('ai-insights-container');
            container.innerHTML = '';

            if (closedTrades.length < 5) {
                container.innerHTML = `<div style="color: var(--text-muted);">Gathering more trades history to formulate AI coaching weights.</div>`;
                return;
            }

            const symData = {};
            closedTrades.forEach(t => {
                const sym = t.symbol;
                if (!symData[sym]) symData[sym] = { trades: 0, wins: 0, profit: 0 };
                symData[sym].trades++;
                const pnl = parseFloat(t.pnl_usd || 0);
                symData[sym].profit += pnl;
                if (pnl > 0) symData[sym].wins++;
            });

            let bestSym = "";
            let bestWR = -1;
            let worstSym = "";
            let worstWR = 101;

            Object.keys(symData).forEach(sym => {
                const wr = (symData[sym].wins / symData[sym].trades) * 100;
                if (wr > bestWR && symData[sym].trades >= 3) {
                    bestWR = wr;
                    bestSym = sym;
                }
                if (wr < worstWR && symData[sym].trades >= 3) {
                    worstWR = wr;
                    worstSym = sym;
                }
            });

            if (bestSym) {
                const div = document.createElement('div');
                div.className = 'insight-box';
                div.innerHTML = `
                    <div class="explainer-label text-green">Symbol Optimization Recommendation</div>
                    <div style="font-size: 14px;">Win rate for <strong>${bestSym}</strong> is high at <strong>${bestWR.toFixed(0)}%</strong>. Consider allocating higher capital weights.</div>
                `;
                container.appendChild(div);
            }

            if (worstSym && worstWR < 50) {
                const div = document.createElement('div');
                div.className = 'insight-box';
                div.innerHTML = `
                    <div class="explainer-label text-red">Underperforming Asset Alert</div>
                    <div style="font-size: 14px;"><strong>${worstSym}</strong> win rate is only <strong>${worstWR.toFixed(0)}%</strong>. Consider lowering its priority weight.</div>
                `;
                container.appendChild(div);
            }
        }

        function renderEquityChart() {
            if (closedTrades.length === 0) return;

            let eq = 150.0;
            const dates = [];
            const data = [150.0];

            const chronological = [...closedTrades].reverse();
            chronological.forEach(t => {
                eq += parseFloat(t.pnl_usd || 0);
                data.push(parseFloat(eq.toFixed(2)));
                dates.push(t.timestamp_open.substring(11, 16));
            });

            dates.unshift("Start");

            const options = {
                series: [{
                    name: 'Simulated Equity ($)',
                    data: data
                }],
                chart: {
                    type: 'area',
                    height: 180,
                    background: 'transparent',
                    foreColor: '#838fa7',
                    toolbar: { show: false }
                },
                colors: ['#00ffcc'],
                stroke: {
                    curve: 'smooth',
                    width: 3
                },
                fill: {
                    type: 'gradient',
                    gradient: {
                        shadeIntensity: 1,
                        opacityFrom: 0.35,
                        opacityTo: 0.01,
                        stops: [0, 90, 100]
                    }
                },
                grid: {
                    borderColor: 'rgba(255, 255, 255, 0.05)',
                    strokeDashArray: 4
                },
                xaxis: {
                    categories: dates,
                    axisBorder: { show: false },
                    axisTicks: { show: false }
                },
                yaxis: {
                    labels: {
                        formatter: function (value) {
                            return "$" + value.toFixed(2);
                        }
                    }
                },
                tooltip: {
                    theme: 'dark'
                }
            };

            if (chart) {
                chart.updateSeries([{ data: data }]);
            } else {
                chart = new ApexCharts(document.querySelector("#equity-chart"), options);
                chart.render();
            }
        }

        function renderMonteCarloChart(paths) {
            const series = [];
            paths.forEach((p, idx) => {
                series.push({
                    name: `Simulation Path #${idx+1}`,
                    data: p
                });
            });
            
            const options = {
                series: series,
                chart: {
                    type: 'line',
                    height: 250,
                    background: 'transparent',
                    foreColor: '#838fa7',
                    toolbar: { show: false }
                },
                stroke: {
                    width: 2,
                    curve: 'smooth'
                },
                grid: {
                    borderColor: 'rgba(255,255,255,0.05)'
                },
                xaxis: {
                    categories: Array.from({length: 31}, (_, i) => `D${i}`)
                },
                tooltip: {
                    theme: 'dark'
                }
            };

            if (mcChart) {
                mcChart.updateSeries(series);
            } else {
                mcChart = new ApexCharts(document.querySelector("#monte-carlo-chart"), options);
                mcChart.render();
            }
        }

        async function sendCommand(action) {
            try {
                const url = action === 'halt' ? '/api/v1/commands/halt' : '/api/v1/commands/resume';
                const body = action === 'halt' ? JSON.stringify({reason: 'Manual UI Halt'}) : null;
                const headers = action === 'halt' ? {'Content-Type': 'application/json'} : {};
                
                await fetch(url, {
                    method: 'POST',
                    headers: headers,
                    body: body
                });
                fetchDashboard();
            } catch (e) {
                alert("Failed to send command: " + e);
            }
        }

        async function closeAll() {
            if (confirm("Are you sure you want to trigger emergency CLOSE-ALL for all open positions?")) {
                try {
                    await fetch('/api/v1/commands/close-all', { method: 'POST' });
                    fetchDashboard();
                } catch(e) {
                    alert("Emergency close request failed: " + e);
                }
            }
        }

        // ─── ZOHRA CHAT ─────────────────────────────────────────
        const chatSessionId = 'session_' + Date.now();

        async function sendChatMessage(messageText) {
            const input = document.getElementById('zohra-chat-input');
            const msg = messageText || input.value.trim();
            if (!msg) return;
            input.value = '';

            // Add user message
            const messagesDiv = document.getElementById('zohra-chat-messages');
            messagesDiv.innerHTML += `<div class="chat-msg user">${escapeHtml(msg)}</div>`;

            // Show typing indicator
            document.getElementById('chat-typing').style.display = 'block';
            messagesDiv.scrollTop = messagesDiv.scrollHeight;

            try {
                const res = await fetch('/api/v1/chat/stream', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ session_id: chatSessionId, message: msg })
                });

                if (!res.ok) {
                    throw new Error("HTTP error " + res.status);
                }

                document.getElementById('chat-typing').style.display = 'none';

                // Create bot response card
                const botCard = document.createElement('div');
                botCard.className = 'chat-msg bot';
                
                // Collapsible reasoning details panel
                const reasoningDetails = document.createElement('details');
                reasoningDetails.open = true;
                reasoningDetails.style.marginBottom = '12px';
                reasoningDetails.style.opacity = '0.9';
                reasoningDetails.style.background = 'rgba(138,43,226,0.05)';
                reasoningDetails.style.border = '1px solid rgba(138,43,226,0.2)';
                reasoningDetails.style.borderRadius = '8px';
                reasoningDetails.style.padding = '8px';
                
                const reasoningSummary = document.createElement('summary');
                reasoningSummary.style.cursor = 'pointer';
                reasoningSummary.style.color = 'var(--accent)';
                reasoningSummary.style.fontWeight = 'bold';
                reasoningSummary.innerText = '🧠 Agent Reasoning & Steps';
                
                const reasoningText = document.createElement('div');
                reasoningText.style.padding = '8px 0 0 0';
                reasoningText.style.fontSize = '12px';
                reasoningText.style.fontFamily = 'monospace';
                reasoningText.style.color = 'var(--text-muted)';
                reasoningText.style.whiteSpace = 'pre-wrap';
                
                reasoningDetails.appendChild(reasoningSummary);
                reasoningDetails.appendChild(reasoningText);
                botCard.appendChild(reasoningDetails);

                // Text response container
                const responseContainer = document.createElement('div');
                botCard.appendChild(responseContainer);
                messagesDiv.appendChild(botCard);
                
                // Read stream
                const reader = res.body.getReader();
                const decoder = new TextDecoder('utf-8');
                let buffer = '';
                let rawAccumulatedText = '';

                while (true) {
                    const { value, done } = await reader.read();
                    if (done) break;
                    
                    buffer += decoder.decode(value, { stream: true });
                    const lines = buffer.split('\n');
                    buffer = lines.pop();

                    for (const line of lines) {
                        const cleanLine = line.trim();
                        if (cleanLine.startsWith('data: ')) {
                            const rawData = cleanLine.substring(6);
                            try {
                                const payload = JSON.parse(rawData);
                                if (payload.type === 'thought') {
                                    reasoningText.innerText += `\n-> ${payload.content}`;
                                    messagesDiv.scrollTop = messagesDiv.scrollHeight;
                                } else if (payload.type === 'tool') {
                                    reasoningText.innerText += `\n🛠️ [Tool] ${payload.name}(${JSON.stringify(payload.args)})`;
                                    messagesDiv.scrollTop = messagesDiv.scrollHeight;
                                } else if (payload.type === 'token') {
                                    if (reasoningDetails.open) {
                                        reasoningDetails.open = false; // collapse reasoning once response starts
                                    }
                                    rawAccumulatedText += payload.content;
                                    responseContainer.innerHTML = formatChatResponse(rawAccumulatedText);
                                    messagesDiv.scrollTop = messagesDiv.scrollHeight;
                                } else if (payload.type === 'error') {
                                    responseContainer.innerHTML += `<div style="color:var(--danger)">⚠️ Error: ${payload.content}</div>`;
                                    messagesDiv.scrollTop = messagesDiv.scrollHeight;
                                }
                            } catch (err) {
                                console.error("Error parsing JSON stream chunk:", err);
                            }
                        }
                    }
                }
            } catch(e) {
                document.getElementById('chat-typing').style.display = 'none';
                messagesDiv.innerHTML += `<div class="chat-msg bot" style="border-color: var(--danger);"><div>⚠️ Connection error: ${e.message}</div></div>`;
            }
            messagesDiv.scrollTop = messagesDiv.scrollHeight;
        }

        function formatChatResponse(text) {
            const lines = text.split('\n');
            let html = '';
            let inTable = false;
            let inCode = false;
            
            for (let i = 0; i < lines.length; i++) {
                const line = lines[i].trim();
                
                if (line.startsWith('```')) {
                    if (inCode) {
                        html += '</code></pre>';
                        inCode = false;
                    } else {
                        html += '<pre style="background:rgba(0,0,0,0.3); padding:10px; border-radius:8px; border:1px solid var(--border); overflow-x:auto;"><code style="font-family:monospace; color:var(--accent);">';
                        inCode = true;
                    }
                    continue;
                }
                
                if (inCode) {
                    html += escapeHtml(lines[i]) + '\n';
                    continue;
                }
                
                if (line.startsWith('|')) {
                    const cells = line.split('|').map(c => c.trim()).filter((c, idx, arr) => idx > 0 && idx < arr.length - 1);
                    if (cells.length > 0) {
                        if (cells.every(c => c.startsWith('-') || c.startsWith(':'))) {
                            continue;
                        }
                        
                        if (!inTable) {
                            html += '<table style="width:100%; border-collapse:collapse; margin:12px 0; border:1px solid var(--border);"><thead><tr style="background:rgba(255,255,255,0.03);">';
                            cells.forEach(c => {
                                html += `<th style="padding:10px; border:1px solid var(--border); text-align:left; color:var(--accent); font-weight:600;">${c}</th>`;
                            });
                            html += '</tr></thead><tbody>';
                            inTable = true;
                        } else {
                            html += '<tr>';
                            cells.forEach(c => {
                                html += `<td style="padding:10px; border:1px solid var(--border);">${parseLineFormatting(c)}</td>`;
                            });
                            html += '</tr>';
                        }
                        continue;
                    }
                } else if (inTable) {
                    html += '</tbody></table>';
                    inTable = false;
                }
                
                if (line.startsWith('*') || line.startsWith('-')) {
                    html += `<li style="margin-left:18px; margin-bottom:6px; list-style-type:square;">${parseLineFormatting(line.substring(1).trim())}</li>`;
                    continue;
                }
                
                if (line === '') {
                    html += '<br>';
                } else {
                    html += `<div style="margin-bottom:8px; line-height:1.5;">${parseLineFormatting(line)}</div>`;
                }
            }
            
            if (inTable) html += '</tbody></table>';
            if (inCode) html += '</code></pre>';
            
            return html;
        }

        function parseLineFormatting(text) {
            return text
                .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                .replace(/\*(.*?)\*/g, '<em>$1</em>')
                .replace(/`(.*?)`/g, '<code style="background:rgba(255,255,255,0.08); padding:2px 6px; border-radius:4px; font-family:monospace; color:var(--accent); font-size:13px;">$1</code>');
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function handleChatKeydown(e) {
            if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendChatMessage(); }
        }

        // ─── AI MEMORY ──────────────────────────────────────────
        async function searchMemory() {
            const query = document.getElementById('memory-search-input').value.trim();
            const container = document.getElementById('memory-results');
            if (!query) { loadRecentMemories(); return; }
            container.innerHTML = '<div style="color:var(--text-muted)">Searching memories...</div>';
            try {
                const res = await fetch(`/api/v1/memory/search?q=${encodeURIComponent(query)}`);
                const data = await res.json();
                renderMemoryCards(data.results || []);
            } catch(e) {
                container.innerHTML = `<div style="color:var(--danger)">Error: ${e.message}</div>`;
            }
        }

        async function loadRecentMemories() {
            const container = document.getElementById('memory-results');
            try {
                const res = await fetch('/api/v1/memory/recent');
                const data = await res.json();
                document.getElementById('memory-total-count').textContent = data.total || '0';
                renderMemoryCards(data.entries || []);
            } catch(e) {
                container.innerHTML = `<div style="color:var(--text-muted)">Memory store offline or empty.</div>`;
            }
        }

        function renderMemoryCards(entries) {
            const container = document.getElementById('memory-results');
            if (!entries.length) { container.innerHTML = '<div style="color:var(--text-muted)">No memories found.</div>'; return; }
            const categoryColors = { 'winning_trade': 'var(--success)', 'losing_trade': 'var(--danger)', 'market_event': 'var(--primary)', 'strategy_insight': '#fbbf24' };
            container.innerHTML = entries.map(m => {
                const color = categoryColors[m.category] || 'var(--text-muted)';
                return `<div class="card" style="padding:16px; border-left: 3px solid ${color};">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
                        <span style="background:${color}22;color:${color};padding:2px 10px;border-radius:10px;font-size:11px;">${m.category || 'unknown'}</span>
                        <span style="font-size:11px;color:var(--text-muted)">${m.timestamp ? new Date(m.timestamp).toLocaleString() : ''}</span>
                    </div>
                    <div style="font-size:13px;line-height:1.5;">${escapeHtml(m.context_text || m.text || '')}</div>
                </div>`;
            }).join('');
        }

        // ─── LEARNING ENGINE ────────────────────────────────────
        async function loadLearningData() {
            try {
                const [pRes, rRes] = await Promise.all([
                    fetch('/api/v1/learning/patterns'),
                    fetch('/api/v1/learning/recommendations')
                ]);
                const patterns = await pRes.json();
                const recommendations = await rRes.json();

                renderPatterns('winning-patterns-container', patterns.winning_patterns || [], 'var(--success)');
                renderPatterns('failure-patterns-container', patterns.failure_patterns || [], 'var(--danger)');
                renderRecommendations(recommendations.recommendations || []);
            } catch(e) {
                document.getElementById('winning-patterns-container').innerHTML = '<div style="color:var(--text-muted)">Learning engine offline.</div>';
            }
        }

        function renderPatterns(containerId, patterns, color) {
            const container = document.getElementById(containerId);
            if (!patterns.length) { container.innerHTML = '<div style="color:var(--text-muted)">No patterns discovered yet.</div>'; return; }
            container.innerHTML = patterns.map(p => `
                <div class="card" style="padding:14px;border-left:3px solid ${color};margin-bottom:10px;">
                    <div style="font-weight:600;font-size:14px;margin-bottom:6px;color:${color}">${escapeHtml(p.pattern_signature || '')}</div>
                    <div style="font-size:12px;color:var(--text-muted);margin-bottom:6px;">Confluences: ${escapeHtml(p.confluences || '[]')}</div>
                    <div style="display:flex;gap:16px;font-size:12px;">
                        <span>Occurrences: <strong>${p.occurrences || 0}</strong></span>
                        <span>Success: <strong style="color:${color}">${((p.success_rate || p.fail_rate || 0) * 100).toFixed(1)}%</strong></span>
                        <span>Avg P&L: <strong>$${(p.avg_pnl || p.avg_loss || 0).toFixed(2)}</strong></span>
                    </div>
                </div>`).join('');
        }

        function renderRecommendations(recs) {
            const container = document.getElementById('learning-recommendations-container');
            if (!recs.length) { container.innerHTML = '<div style="color:var(--text-muted)">No recommendations generated yet.</div>'; return; }
            container.innerHTML = recs.map(r => `
                <div class="card" style="padding:14px;margin-bottom:10px;border-left:3px solid ${r.applied ? 'var(--success)' : '#fbbf24'};">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
                        <span style="background:rgba(138,43,226,0.15);color:var(--primary);padding:2px 10px;border-radius:10px;font-size:11px;">${r.category || 'general'}</span>
                        <span style="font-size:11px;color:${r.applied ? 'var(--success)' : '#fbbf24'}">${r.applied ? '✅ Applied' : '⏳ Pending'}</span>
                    </div>
                    <div style="font-size:13px;line-height:1.5;margin-bottom:6px;">${escapeHtml(r.recommendation_text || '')}</div>
                    <div style="font-size:11px;color:var(--text-muted)">Evidence: ${escapeHtml(r.supporting_evidence || '')}</div>
                </div>`).join('');
        }

        }

        // ─── WebSocket connection ───
        let ws = null;
        function connectWebSocket() {
            const proto = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
            const wsUrl = `${proto}//${window.location.host}/api/v1/ws`;
            console.log(`Connecting to WebSocket: ${wsUrl}`);
            ws = new WebSocket(wsUrl);
            ws.onmessage = function(event) {
                const data = JSON.parse(event.data);
                if (data.type === 'state_update') {
                    const state = data.state;
                    const account = data.account;
                    
                    document.getElementById('kpi-trades').innerText = state.daily_trades;
                    document.getElementById('kpi-today-pnl').querySelector('.kpi-val').innerText = `$${state.daily_pnl.toFixed(2)}`;
                    document.getElementById('kpi-today-pnl').className = state.daily_pnl >= 0 ? 'kpi-box green' : 'kpi-box red';
                    document.getElementById('engine-status-text').innerText = state.trading_halted ? 'HALTED' : 'ACTIVE';
                    document.getElementById('engine-status-text').className = state.trading_halted ? 'text-red' : 'text-green';

                    const targetRem = Math.max(0.0, 25.0 - state.daily_pnl);
                    document.getElementById('kpi-target-remaining').querySelector('.kpi-val').innerText = `$${targetRem.toFixed(2)}`;
                    document.getElementById('kpi-target-remaining').className = targetRem === 0 ? 'kpi-box green' : 'kpi-box';
                    
                    if (account && account.equity) {
                        document.getElementById('kpi-equity').innerText = `$${account.equity.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
                        
                        const marginLevelElem = document.getElementById('margin-level-val');
                        if (marginLevelElem) marginLevelElem.innerText = `${account.margin_level || '100'}%`;
                        
                        const marginUsedElem = document.getElementById('margin-used-val');
                        if (marginUsedElem) marginUsedElem.innerText = `$${account.margin.toFixed(2)}`;
                        
                        const marginFreeElem = document.getElementById('margin-free-val');
                        if (marginFreeElem) marginFreeElem.innerText = `$${account.free_margin.toFixed(2)}`;
                    }
                }
            };
            ws.onclose = function() {
                console.log("WebSocket closed. Reconnecting in 5 seconds...");
                setTimeout(connectWebSocket, 5000);
            };
            ws.onerror = function(err) {
                console.error("WebSocket error:", err);
                ws.close();
            };
        }

        // ─── Settings load/save ───
        async function loadSettings() {
            try {
                const res = await fetch('/api/v1/settings');
                const data = await res.json();
                
                document.getElementById('settings-risk-pct').value = (data.risk_per_trade_pct * 100).toFixed(1);
                document.getElementById('risk-val').innerText = (data.risk_per_trade_pct * 100).toFixed(1) + '%';
                
                document.getElementById('settings-max-drawdown').value = (data.max_drawdown_pct * 100).toFixed(1);
                document.getElementById('dd-val').innerText = (data.max_drawdown_pct * 100).toFixed(1) + '%';
                
                document.getElementById('settings-max-daily-loss').value = (data.max_daily_loss_pct * 100).toFixed(1);
                document.getElementById('loss-val').innerText = (data.max_daily_loss_pct * 100).toFixed(1) + '%';
                
                document.getElementById('settings-allow-c').checked = data.allow_c_setups;
                document.getElementById('settings-max-positions').value = data.max_open_positions;
            } catch (e) {
                console.error("Failed to load settings:", e);
            }
        }
        
        async function saveSettings() {
            const token = document.getElementById('settings-api-token').value.trim();
            if (!token) {
                alert("Please enter your API Access Token to modify settings.");
                return;
            }
            
            const payload = {
                risk_per_trade_pct: parseFloat(document.getElementById('settings-risk-pct').value) / 100,
                max_drawdown_pct: parseFloat(document.getElementById('settings-max-drawdown').value) / 100,
                max_daily_loss_pct: parseFloat(document.getElementById('settings-max-daily-loss').value) / 100,
                allow_c_setups: document.getElementById('settings-allow-c').checked,
                max_open_positions: parseInt(document.getElementById('settings-max-positions').value)
            };
            
            try {
                const res = await fetch('/api/v1/settings', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'X-API-Key': token
                    },
                    body: JSON.stringify(payload)
                });
                const result = await res.json();
                if (result.status === 'success') {
                    alert("Settings updated successfully!");
                } else {
                    alert("Failed to update settings: " + JSON.stringify(result));
                }
            } catch (e) {
                alert("Failed to save settings: " + e);
            }
        }

        // ─── TradingView Widget ───
        let tvWidget = null;
        function initTradingViewWidget(symbol = "XAUUSD") {
            let tvSymbol = "FX:" + symbol;
            if (symbol === "XAUUSD") {
                tvSymbol = "OANDA:XAUUSD";
            } else if (symbol === "XAGUSD") {
                tvSymbol = "OANDA:XAGUSD";
            } else if (symbol.includes("US100")) {
                tvSymbol = "NDAQ:US100";
            }
            
            if (typeof TradingView !== "undefined") {
                tvWidget = new TradingView.widget({
                    "width": "100%",
                    "height": "100%",
                    "symbol": tvSymbol,
                    "interval": "5",
                    "timezone": "Etc/UTC",
                    "theme": "dark",
                    "style": "1",
                    "locale": "en",
                    "enable_publishing": false,
                    "hide_side_toolbar": false,
                    "allow_symbol_change": true,
                    "container_id": "tradingview_widget"
                });
            }
        }

        // ─── Web Speech APIs ───
        let isSpeakingEnabled = false;
        let recognition = null;
        let isRecording = false;

        function speak(text) {
            if (!isSpeakingEnabled) return;
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const cleanText = text.replace(/<[^>]*>/g, '').replace(/\*+/g, '').replace(/➤/g, '').replace(/#/g, '');
                const utterance = new SpeechSynthesisUtterance(cleanText);
                utterance.rate = 1.05;
                window.speechSynthesis.speak(utterance);
            }
        }

        function initSpeechRecognition() {
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!SpeechRecognition) {
                console.warn("Web Speech API not supported in this browser.");
                return;
            }
            recognition = new SpeechRecognition();
            recognition.continuous = false;
            recognition.interimResults = false;
            recognition.lang = 'en-US';
            
            recognition.onstart = function() {
                isRecording = true;
                const btn = document.getElementById('zohra-mic-btn');
                btn.innerText = '🔴';
                btn.style.boxShadow = '0 0 10px var(--danger)';
            };
            
            recognition.onend = function() {
                isRecording = false;
                const btn = document.getElementById('zohra-mic-btn');
                btn.innerText = '🎙️';
                btn.style.boxShadow = 'none';
            };
            
            recognition.onresult = function(event) {
                const transcript = event.results[0][0].transcript;
                document.getElementById('zohra-chat-input').value = transcript;
                isSpeakingEnabled = true;
                sendChatMessage(transcript);
            };
            
            recognition.onerror = function(err) {
                console.error("Speech recognition error:", err);
            };
        }

        function toggleSpeech() {
            if (!recognition) {
                initSpeechRecognition();
            }
            if (!recognition) return;
            
            if (isRecording) {
                recognition.stop();
            } else {
                recognition.start();
            }
        }

        // Hook speech synthesis feedback to sendChatMessage
        const originalSendChatMessage = sendChatMessage;
        sendChatMessage = async function(messageText) {
            await originalSendChatMessage(messageText);
            const messagesDiv = document.getElementById('zohra-chat-messages');
            const lastMsg = messagesDiv.querySelector('.chat-msg.bot:last-child');
            if (lastMsg && isSpeakingEnabled) {
                const text = lastMsg.innerText;
                speak(text);
            }
        };

        window.addEventListener('load', initDashboard);
    </script>
</body>
</html>
