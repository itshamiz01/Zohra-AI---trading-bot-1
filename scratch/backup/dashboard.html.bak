<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Zohra AI | Institutional Intelligence Command Center</title>
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- ApexCharts CDN -->
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script src="https://s3.tradingview.com/tv.js"></script>
    <style>
        :root {
            --bg: #05060b;
            --card-bg: rgba(13, 16, 29, 0.75);
            --card-border: rgba(255, 255, 255, 0.05);
            --card-hover: rgba(255, 255, 255, 0.09);
            --primary: #8a2be2;
            --primary-glow: rgba(138, 43, 226, 0.35);
            --accent: #00ffcc;
            --accent-glow: rgba(0, 255, 204, 0.2);
            --danger: #ff007f;
            --danger-glow: rgba(255, 0, 127, 0.2);
            --text-main: #f3f4f6;
            --text-muted: #838fa7;
            --success: #00ffcc;
        }

        * {
            box-sizing: border-box;
            scrollbar-width: thin;
            scrollbar-color: rgba(255,255,255,0.1) transparent;
        }

        body {
            font-family: 'Space Grotesk', sans-serif;
            background-color: var(--bg);
            color: var(--text-main);
            margin: 0;
            padding: 0;
            background-image: radial-gradient(circle at 10% 20%, rgba(138, 43, 226, 0.12) 0%, transparent 40%),
                              radial-gradient(circle at 90% 80%, rgba(0, 255, 204, 0.05) 0%, transparent 45%);
            background-attachment: fixed;
            min-height: 100vh;
            overflow-x: hidden;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px 40px;
            background: rgba(5, 6, 11, 0.85);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--card-border);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo-container {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        h1 {
            font-family: 'Outfit', sans-serif;
            font-weight: 800;
            font-size: 24px;
            margin: 0;
            background: linear-gradient(45deg, #b026ff, #00ffcc);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: 0.5px;
        }

        .pulse-badge {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background-color: var(--accent);
            box-shadow: 0 0 10px var(--accent);
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% { transform: scale(0.9); opacity: 0.7; }
            50% { transform: scale(1.1); opacity: 1; box-shadow: 0 0 15px var(--accent); }
            100% { transform: scale(0.9); opacity: 0.7; }
        }

        .btn-group {
            display: flex;
            gap: 12px;
        }

        .btn {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--card-border);
            color: var(--text-main);
            padding: 9px 18px;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            font-family: inherit;
            font-size: 13px;
            font-weight: 600;
        }

        .btn:hover {
            background: var(--primary);
            border-color: var(--primary);
            box-shadow: 0 0 15px var(--primary-glow);
            transform: translateY(-1px);
        }

        .btn-danger {
            background: rgba(255, 0, 127, 0.08);
            border-color: rgba(255, 0, 127, 0.25);
            color: var(--danger);
        }

        .btn-danger:hover {
            background: var(--danger);
            border-color: var(--danger);
            box-shadow: 0 0 15px var(--danger-glow);
            color: #fff;
        }

        /* Tabs Layout */
        .tabs-nav {
            display: flex;
            gap: 8px;
            padding: 10px 40px;
            background: rgba(13, 16, 29, 0.4);
            border-bottom: 1px solid var(--card-border);
            overflow-x: auto;
        }

        .tab-btn {
            background: transparent;
            border: none;
            color: var(--text-muted);
            padding: 10px 16px;
            border-radius: 8px;
            cursor: pointer;
            font-family: inherit;
            font-weight: 600;
            font-size: 13px;
            transition: all 0.2s ease;
            white-space: nowrap;
        }

        .tab-btn:hover {
            color: var(--text-main);
            background: rgba(255,255,255,0.03);
        }

        .tab-btn.active {
            color: var(--accent);
            background: rgba(0, 255, 204, 0.06);
            border: 1px solid rgba(0, 255, 204, 0.15);
        }

        /* Core Grid */
        .tab-content {
            display: none;
            max-width: 1650px;
            margin: 0 auto;
            padding: 30px 40px;
            animation: fadeIn 0.35s ease;
        }

        .tab-content.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .dashboard-grid {
            display: grid;
            grid-template-columns: repeat(12, 1fr);
            gap: 25px;
        }

        .card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 18px;
            padding: 24px;
            backdrop-filter: blur(24px);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .card:hover {
            border-color: var(--card-hover);
        }

        .col-3 { grid-column: span 3; }
        .col-4 { grid-column: span 4; }
        .col-5 { grid-column: span 5; }
        .col-6 { grid-column: span 6; }
        .col-7 { grid-column: span 7; }
        .col-8 { grid-column: span 8; }
        .col-12 { grid-column: span 12; }

        h2 {
            font-family: 'Outfit', sans-serif;
            font-size: 18px;
            font-weight: 700;
            margin-top: 0;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            letter-spacing: 0.3px;
        }

        /* KPI Panel styling */
        .kpi-row {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 20px;
            margin-bottom: 25px;
        }

        .kpi-box {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--card-border);
            border-radius: 14px;
            padding: 16px;
            position: relative;
            overflow: hidden;
        }

        .kpi-box::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background: var(--primary);
            opacity: 0.3;
        }

        .kpi-box.green::after { background: var(--accent); opacity: 0.6; }
        .kpi-box.red::after { background: var(--danger); opacity: 0.6; }

        .kpi-title {
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            color: var(--text-muted);
            margin-bottom: 8px;
            letter-spacing: 0.5px;
        }

        .kpi-val {
            font-size: 20px;
            font-weight: 700;
            font-family: 'Outfit', sans-serif;
        }

        /* Lists & Tables */
        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            text-align: left;
            padding: 14px 16px;
            color: var(--text-muted);
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            border-bottom: 1px solid var(--card-border);
            letter-spacing: 0.5px;
        }

        td {
            padding: 14px 16px;
            font-size: 14px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.02);
        }

        tr:hover td {
            background: rgba(255, 255, 255, 0.015);
        }

        .badge {
            padding: 4px 10px;
            border-radius: 8px;
            font-size: 11px;
            font-weight: 700;
            display: inline-block;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .badge-buy { background: rgba(0, 255, 204, 0.1); color: var(--accent); border: 1px solid rgba(0, 255, 204, 0.15); }
        .badge-sell { background: rgba(255, 0, 127, 0.1); color: var(--danger); border: 1px solid rgba(255, 0, 127, 0.15); }
        .badge-info { background: rgba(138, 43, 226, 0.1); color: #c084fc; border: 1px solid rgba(138, 43, 226, 0.15); }

        .text-green { color: var(--accent); }
        .text-red { color: var(--danger); }

        /* Exposure heat progress bar */
        .exp-bar-container {
            background: rgba(255,255,255,0.03);
            border-radius: 6px;
            height: 12px;
            width: 100%;
            overflow: hidden;
            margin-top: 4px;
        }
        .exp-bar-fill {
            height: 100%;
            border-radius: 6px;
            transition: width 0.3s ease;
        }

        /* Correlation grid coloring */
        .corr-cell {
            font-weight: 700;
            text-align: center;
        }

        /* Timeline styles */
        .timeline-container {
            display: flex;
            flex-direction: column;
            gap: 15px;
            position: relative;
            padding-left: 20px;
            border-left: 2px dashed rgba(255,255,255,0.1);
            margin-top: 15px;
        }
        .timeline-step {
            position: relative;
        }
        .timeline-step::before {
            content: '';
            position: absolute;
            left: -27px;
            top: 4px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: var(--accent);
            box-shadow: 0 0 8px var(--accent);
        }
        .timeline-step.closed::before {
            background: var(--primary);
            box-shadow: 0 0 8px var(--primary);
        }

        /* Filter elements */
        .filter-row {
            display: flex;
            gap: 15px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .filter-select, .filter-input {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--card-border);
            border-radius: 10px;
            color: var(--text-main);
            padding: 10px 16px;
            font-family: inherit;
            font-size: 13px;
            outline: none;
            transition: border-color 0.2s ease;
        }

        .filter-select:focus, .filter-input:focus {
            border-color: var(--accent);
        }

        .filter-input {
            flex-grow: 1;
            min-width: 250px;
        }

        /* NLP query interface styles */
        .nlp-box {
            display: flex;
            gap: 12px;
            margin-bottom: 20px;
        }
        .nlp-input {
            flex-grow: 1;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--card-border);
            border-radius: 12px;
            color: var(--text-main);
            padding: 14px 20px;
            font-size: 14px;
            font-family: inherit;
            outline: none;
        }
        .nlp-input:focus {
            border-color: var(--accent);
        }
        .nlp-response {
            background: rgba(138, 43, 226, 0.05);
            border: 1px solid rgba(138, 43, 226, 0.2);
            border-radius: 12px;
            padding: 20px;
            font-size: 14px;
            line-height: 1.6;
        }

        /* Modal Explainer styling */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(5, 6, 11, 0.85);
            backdrop-filter: blur(12px);
            z-index: 1000;
            justify-content: center;
            align-items: center;
            animation: fadeIn 0.25s ease;
        }

        .modal-content {
            background: #0d101d;
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 24px;
            width: 90%;
            max-width: 680px;
            padding: 30px;
            max-height: 85vh;
            overflow-y: auto;
            position: relative;
            box-shadow: 0 20px 50px rgba(0,0,0,0.5);
        }

        .modal-close {
            position: absolute;
            top: 20px;
            right: 20px;
            background: rgba(255,255,255,0.03);
            border: 1px solid var(--card-border);
            border-radius: 50%;
            width: 36px;
            height: 36px;
            color: var(--text-main);
            cursor: pointer;
            font-size: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
        }

        .modal-close:hover {
            background: var(--danger);
            border-color: var(--danger);
            color: #fff;
        }

        .explainer-title {
            font-family: 'Outfit', sans-serif;
            font-weight: 700;
            font-size: 22px;
            margin-bottom: 25px;
            border-bottom: 1px solid var(--card-border);
            padding-bottom: 15px;
        }

        .explainer-block {
            background: rgba(255,255,255,0.02);
            border-radius: 12px;
            padding: 16px;
            margin-bottom: 15px;
            border-left: 4px solid var(--primary);
        }

        .explainer-block.taken { border-left-color: var(--accent); }
        .explainer-block.lost { border-left-color: var(--danger); }

        .explainer-label {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            color: var(--text-muted);
            margin-bottom: 6px;
        }

        .explainer-val {
            font-size: 14px;
            line-height: 1.5;
        }

        .check-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            margin-top: 15px;
        }

        .check-item {
            background: rgba(255,255,255,0.01);
            border: 1px solid var(--card-border);
            border-radius: 8px;
            padding: 10px;
            font-size: 13px;
            display: flex;
            justify-content: space-between;
        }

        /* Coach section cards */
        .coach-card {
            background: rgba(138, 43, 226, 0.04);
            border: 1px solid rgba(138, 43, 226, 0.15);
            border-radius: 18px;
            padding: 24px;
            margin-bottom: 25px;
            position: relative;
        }

        .coach-card::before {
            content: "💡 AI COACH TIP";
            position: absolute;
            top: -12px;
            left: 20px;
            background: var(--primary);
            color: #fff;
            padding: 3px 12px;
            font-size: 10px;
            font-weight: 700;
            border-radius: 6px;
            letter-spacing: 0.5px;
        }

        .insight-list {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .insight-box {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--card-border);
            border-radius: 12px;
            padding: 18px;
        }

        /* ─── ZOHRA CHAT ──────────────────────────────────── */
        .chat-container { display: flex; flex-direction: column; height: 70vh; background: var(--card-bg); border-radius: 16px; border: 1px solid var(--card-border); overflow: hidden; }
        .chat-messages { flex: 1; overflow-y: auto; padding: 24px; display: flex; flex-direction: column; gap: 16px; }
        .chat-msg { max-width: 75%; padding: 14px 18px; border-radius: 16px; font-size: 14px; line-height: 1.6; animation: fadeSlideIn 0.3s ease; }
        .chat-msg.user { align-self: flex-end; background: linear-gradient(135deg, #8a2be2, #6a1fb0); color: white; border-bottom-right-radius: 4px; }
        .chat-msg.bot { align-self: flex-start; background: rgba(20,24,40,0.9); border: 1px solid var(--card-border); border-bottom-left-radius: 4px; color: var(--text-main); }
        .chat-msg.bot .intent-badge { display: inline-block; background: rgba(0,255,204,0.15); color: var(--accent); padding: 2px 8px; border-radius: 8px; font-size: 11px; margin-bottom: 6px; }
        .chat-input-area { padding: 16px 20px; background: rgba(5,6,11,0.9); border-top: 1px solid var(--card-border); display: flex; gap: 12px; align-items: center; }
        .chat-input-area input { flex: 1; background: rgba(255,255,255,0.05); border: 1px solid var(--card-border); border-radius: 12px; padding: 12px 16px; color: var(--text-main); font-size: 14px; font-family: 'Space Grotesk'; outline: none; transition: border 0.2s; }
        .chat-input-area input:focus { border-color: var(--primary); }
        .chat-send-btn { background: linear-gradient(135deg, #8a2be2, #6a1fb0); border: none; color: white; padding: 12px 20px; border-radius: 12px; cursor: pointer; font-weight: 600; transition: all 0.2s; }
        .chat-send-btn:hover { transform: scale(1.05); box-shadow: 0 0 20px var(--primary-glow); }
        .chat-quick-actions { display: flex; gap: 8px; padding: 10px 20px; flex-wrap: wrap; }
        .chat-quick-btn { background: rgba(138,43,226,0.1); border: 1px solid rgba(138,43,226,0.3); color: var(--accent); padding: 6px 14px; border-radius: 20px; font-size: 12px; cursor: pointer; transition: all 0.2s; font-family: 'Space Grotesk'; }
        .chat-quick-btn:hover { background: rgba(138,43,226,0.25); transform: translateY(-1px); }
        .typing-indicator { display: none; align-self: flex-start; padding: 12px 18px; background: rgba(20,24,40,0.9); border-radius: 16px; border: 1px solid var(--card-border); }
        .typing-indicator span { display: inline-block; width: 8px; height: 8px; background: var(--accent); border-radius: 50%; animation: typingBounce 1.4s infinite; margin: 0 2px; }
        .typing-indicator span:nth-child(2) { animation-delay: 0.2s; }
        .typing-indicator span:nth-child(3) { animation-delay: 0.4s; }
        @keyframes typingBounce { 0%, 60%, 100% { transform: translateY(0); } 30% { transform: translateY(-8px); } }
        @keyframes fadeSlideIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        /* ─── AI MEMORY ───────────────────────────────────── */
        .memory-search-bar { display: flex; gap: 12px; margin-bottom: 20px; }
        .memory-search-bar input { flex: 1; background: rgba(255,255,255,0.05); border: 1px solid var(--card-border); border-radius: 12px; padding: 12px 16px; color: var(--text-main); font-size: 14px; font-family: 'Space Grotesk'; outline: none; transition: border 0.2s; }
        .memory-search-bar input:focus { border-color: var(--primary); }
        .memory-search-bar button { background: linear-gradient(135deg, #8a2be2, #6a1fb0); border: none; color: white; padding: 12px 20px; border-radius: 12px; cursor: pointer; font-weight: 600; transition: all 0.2s; font-family: 'Space Grotesk'; }
        .memory-search-bar button:hover { transform: scale(1.05); box-shadow: 0 0 20px var(--primary-glow); }
        .memory-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 16px; }

        /* ─── LEARNING ENGINE ─────────────────────────────── */
        .learning-columns { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 24px; }
        @media (max-width: 900px) { .learning-columns { grid-template-columns: 1fr; } }
    </style>
</head>
<body>

    <header>
        <div class="logo-container">
            <div class="pulse-badge"></div>
            <h1>ZOHRA | Institutional command center</h1>
        </div>
        <div class="btn-group">
            <button class="btn" onclick="sendCommand('resume')">RESUME SCANS</button>
            <button class="btn btn-danger" onclick="sendCommand('halt')">HALT ENGINE</button>
            <button class="btn btn-danger" onclick="closeAll()">CLOSE ALL</button>
        </div>
    </header>

    <div class="tabs-nav">
        <button class="tab-btn active" id="tab-overview" onclick="switchTab('overview')">Overview</button>
        <button class="tab-btn" id="tab-risk" onclick="switchTab('risk')">Risk & Exposure</button>
        <button class="tab-btn" id="tab-strategies" onclick="switchTab('strategies')">Strategy Matrix</button>
        <button class="tab-btn" id="tab-playback" onclick="switchTab('playback')">Replay & Timeline</button>
        <button class="tab-btn" id="tab-health" onclick="switchTab('health')">System Health</button>
        <button class="tab-btn" id="tab-ai-coach" onclick="switchTab('ai-coach')">AI Query & Debrief</button>
        <button class="tab-btn" id="tab-simulators" onclick="switchTab('simulators')">Backtest & Sim</button>
        <button class="tab-btn" id="tab-symbols" onclick="switchTab('symbols')">Symbol Performance</button>
        <button class="tab-btn" id="tab-rejections" onclick="switchTab('rejections')">Rejections Log</button>
        <button class="tab-btn" id="tab-journal" onclick="switchTab('journal')">Execution Journal</button>
        <button class="tab-btn" id="tab-coach" onclick="switchTab('coach')">Pattern Coach</button>
        <button class="tab-btn" id="tab-zohra-chat" onclick="switchTab('zohra-chat')">🤖 Zohra Chat</button>
        <button class="tab-btn" id="tab-memory" onclick="switchTab('memory')">🧠 AI Memory</button>
        <button class="tab-btn" id="tab-learning" onclick="switchTab('learning')">📊 Learning Engine</button>
        <button class="tab-btn" id="tab-settings" onclick="switchTab('settings')">⚙️ Settings</button>
    </div>

    <!-- T1: OVERVIEW -->
    <div id="content-overview" class="tab-content active">
        <!-- KPI Row -->
        <div class="kpi-row">
            <div class="kpi-box" id="kpi-today-pnl">
                <div class="kpi-title">Today's P&L</div>
                <div class="kpi-val">$0.00</div>
            </div>
            <div class="kpi-box" id="kpi-target-remaining">
                <div class="kpi-title">Target Remaining</div>
                <div class="kpi-val">$0.00</div>
            </div>
            <div class="kpi-box">
                <div class="kpi-title">Account Equity</div>
                <div class="kpi-val" id="kpi-equity">$0.00</div>
            </div>
            <div class="kpi-box">
                <div class="kpi-title">Daily Trades</div>
                <div class="kpi-val" id="kpi-trades">0</div>
            </div>
            <div class="kpi-box">
                <div class="kpi-title">Profit Factor</div>
                <div class="kpi-val text-green" id="kpi-pf">0.00</div>
            </div>
            <div class="kpi-box">
                <div class="kpi-title">Avg Quality Score</div>
                <div class="kpi-val text-green" id="kpi-avg-quality">0.0</div>
            </div>
        </div>

        <div class="dashboard-grid">
            <!-- Equity curve line chart -->
            <div class="card col-6">
                <h2>Equity Growth Curve (Simulated vs Balance)</h2>
                <div id="equity-chart" style="min-height: 180px; height: 180px;"></div>
            </div>

            <!-- Exposure limits -->
            <div class="card col-6">
                <h2>Exposure & Risk Guard</h2>
                <div style="display: flex; flex-direction: column; gap: 20px; margin-top: 16px;">
                    <div style="display: flex; justify-content: space-between; font-size: 15px;">
                        <span>Engine Status:</span>
                        <strong class="text-green" id="engine-status-text">ACTIVE</strong>
                    </div>
                    <div style="display: flex; justify-content: space-between; font-size: 15px;">
                        <span>Forex Exposure Limits:</span>
                        <strong id="forex-exposure-txt">0 / 3</strong>
                    </div>
