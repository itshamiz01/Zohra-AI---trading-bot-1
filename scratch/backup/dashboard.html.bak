        <div class="chat-container">
            <div class="chat-messages" id="zohra-chat-messages">
                <div class="chat-msg bot">
                    <div class="intent-badge">welcome</div>
                    <div>Hey! I'm <strong>Zohra</strong>, your AI trading assistant. Ask me anything about your trades, strategies, P&L, or market conditions. 🚀</div>
                </div>
            </div>
            <div class="typing-indicator" id="chat-typing">
                <span></span><span></span><span></span>
            </div>
            <div class="chat-quick-actions">
                <button class="chat-quick-btn" onclick="sendChatMessage('Today\'s P&L')">📈 Today's P&L</button>
                <button class="chat-quick-btn" onclick="sendChatMessage('Best strategy?')">🏆 Best strategy?</button>
                <button class="chat-quick-btn" onclick="sendChatMessage('Why last loss?')">❓ Why last loss?</button>
                <button class="chat-quick-btn" onclick="sendChatMessage('Risk status')">🛡️ Risk status</button>
                <button class="chat-quick-btn" onclick="sendChatMessage('Market scan')">🔍 Market scan</button>
            </div>
            <div class="chat-input-area">
                <input type="text" id="zohra-chat-input" placeholder="Ask Zohra anything..." onkeydown="handleChatKeydown(event)" autocomplete="off">
                <button id="zohra-mic-btn" onclick="toggleSpeech()" style="background:rgba(255,255,255,0.05); border:1px solid var(--card-border); color:var(--text-main); font-size:18px; padding:10px 14px; border-radius:12px; cursor:pointer;">🎙️</button>
                <button class="chat-send-btn" onclick="sendChatMessage()">Send ➤</button>
            </div>
        </div>
