# MetaTrader 5 Demo Account (REQUIRED)
# Step 1: Download MT5 from https://www.metatrader5.com/en/download
# Step 2: Open MT5 → File → Open an Account → pick any broker → Demo Account
# Step 3: Fill in the credentials below

MT5_LOGIN=12345678
MT5_PASSWORD=your_demo_password_here
MT5_SERVER=ICMarkets-Demo

# Telegram Bot (OPTIONAL but recommended for alerts)
# Create bot via @BotFather on Telegram, then get your chat ID
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Groq LLM (OPTIONAL for AI Q&A via Telegram)
# Get free API key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# Zohra Database (OPTIONAL — SQLite used if unset)
# PostgreSQL preferred for production:
# DATABASE_URL=postgresql://user:password@localhost:5432/zohra
DB_PATH=logs/zohra.db

# Zohra API Server (OPTIONAL)
ZOHR_API_HOST=127.0.0.1
ZOHR_API_PORT=8000
